{
  "name": "muttello2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dist:pilot": "npm run build && electron-builder",
    "dist:production": "npm run build && node scripts/release-check.mjs",
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "tello:station": "node scripts/tello-station.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg zip -c.mac.identity=null -c.publish=never",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win --x64 -c.publish=never"
  },
  "dependencies": {
    "blockly": "latest",
    "ffmpeg-static": "^5.3.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "appId": "jp.kanawha-st.muttello2",
    "productName": "Muttello2",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "shared/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
